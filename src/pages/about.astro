---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  {
    categoria: 'Frontend',
    emoji: '🎨',
    items: ['HTML', 'CSS', 'JavaScript', 'TypeScript', 'React', 'Astro'],
  },
  { categoria: 'Estilos', emoji: '✨', items: ['TailwindCSS', 'CSS Modules', 'Sass'] },
  { categoria: 'Herramientas', emoji: '🛠️', items: ['Git', 'GitHub', 'VSCode', 'Figma', 'Vite'] },
  { categoria: 'Aprendiendo', emoji: '🚀', items: ['Node.js', 'PostgreSQL', 'Docker'] },
];
---

<BaseLayout titulo="Sobre mí">
  <main class="container mx-auto px-4 py-20">
    <!-- Hero About -->
    <div class="flex flex-col md:flex-row items-center gap-12 mb-24">
      <!-- Avatar -->
      <div class="shrink-0">
        <div
          class="w-40 h-40 rounded-3xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-6xl shadow-2xl shadow-blue-500/25"
        >
          👨‍💻
        </div>
      </div>

      <!-- Texto -->
      <div>
        <div
          class="inline-flex items-center gap-2 bg-blue-500/10 text-blue-400 text-sm font-medium px-4 py-1.5 rounded-full mb-4 border border-blue-500/20"
        >
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
          Disponible para trabajar
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Hola, soy <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-500"
            >David Garcia</span
          >
        </h1>
        <p class="text-gray-400 text-lg leading-relaxed mb-4">
          Desarrollador Frontend apasionado por crear interfaces web modernas, rápidas y accesibles.
          Me especializo en <strong class="text-white">Astro, React y TailwindCSS</strong>.
        </p>
        <p class="text-gray-400 text-lg leading-relaxed">
          Cuando no estoy programando, estoy aprendiendo nuevas tecnologías o explorando diseño
          UI/UX.
        </p>
      </div>
    </div>

    <!-- Skills -->
    <div class="mb-24">
      <h2 class="text-2xl font-bold text-white mb-2">Tecnologías</h2>
      <p class="text-gray-400 mb-8">Herramientas con las que trabajo día a día.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          skills.map((grupo) => (
            <div class="bg-gray-900 border border-gray-800 hover:border-blue-500/50 rounded-2xl p-6 transition-all hover:-translate-y-1">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-2xl">{grupo.emoji}</span>
                <h3 class="text-white font-semibold">{grupo.categoria}</h3>
              </div>
              <ul class="space-y-2">
                {grupo.items.map((skill) => (
                  <li class="flex items-center gap-2 text-gray-400 text-sm">
                    <span class="w-1.5 h-1.5 bg-blue-500 rounded-full shrink-0" />
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <br />
    <!-- CTA -->
    <div
      class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 border border-blue-500/20 rounded-2xl p-12 flex flex-col md:flex-row items-center justify-between gap-8 mt-8"
    >
      <div>
        <h3 class="text-2xl font-bold text-white mb-2">¿Tienes un proyecto en mente?</h3>
        <p class="text-gray-400">
          Estoy disponible para proyectos freelance y oportunidades laborales.
        </p>
      </div>
      <a
        href="/contacto"
        class="shrink-0 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-3 rounded-xl transition-all hover:scale-105 whitespace-nowrap"
      >
        Hablemos →
      </a>
    </div>
  </main>
</BaseLayout>
