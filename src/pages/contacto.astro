---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout titulo="Contacto">
  <main class="container mx-auto px-4 py-20">
    <!-- Header -->
    <div class="max-w-2xl mx-auto text-center mb-16 pt-8">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-500"
          >Hablemos</span
        >
      </h1>
      <p class="text-gray-400 text-lg">
        ¿Tienes un proyecto en mente? Escríbeme y te respondo pronto.
      </p>
    </div>

    <div class="max-w-2xl mx-auto">
      <!-- Info de contacto -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;" class="mb-12">
        <a
          href="mailto:tu@email.com"
          class="bg-gray-900 border border-gray-800 hover:border-blue-500/50 rounded-2xl p-6 text-center transition-all hover:-translate-y-1 block"
        >
          <div class="text-3xl mb-3">📧</div>
          <p class="text-white font-semibold text-sm mb-1">Email</p>
          <p class="text-gray-400 text-xs">tu@email.com</p>
        </a>
        <a
          href="https://github.com/Sagiiiii"
          target="_blank"
          class="bg-gray-900 border border-gray-800 hover:border-blue-500/50 rounded-2xl p-6 text-center transition-all hover:-translate-y-1 block"
        >
          <div class="text-3xl mb-3">🐙</div>
          <p class="text-white font-semibold text-sm mb-1">GitHub</p>
          <p class="text-gray-400 text-xs">@Sagiiiii</p>
        </a>
        <a
          href="https://linkedin.com"
          target="_blank"
          class="bg-gray-900 border border-gray-800 hover:border-blue-500/50 rounded-2xl p-6 text-center transition-all hover:-translate-y-1 block"
        >
          <div class="text-3xl mb-3">💼</div>
          <p class="text-white font-semibold text-sm mb-1">LinkedIn</p>
          <p class="text-gray-400 text-xs">David Garcia</p>
        </a>
      </div>

      <!-- Formulario -->
      <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8">
        <h2 class="text-xl font-bold text-white mb-6">Envíame un mensaje</h2>
        <form action="https://formspree.io/f/xaqkgvvk" method="POST">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;" class="mb-5">
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-2">Nombre</label>
              <input
                type="text"
                name="nombre"
                required
                placeholder="Tu nombre"
                class="w-full bg-gray-800 border border-gray-700 focus:border-blue-500 text-white rounded-xl px-4 py-3 text-sm outline-none transition-colors placeholder:text-gray-500"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-300 mb-2">Email</label>
              <input
                type="email"
                name="email"
                required
                placeholder="tu@email.com"
                class="w-full bg-gray-800 border border-gray-700 focus:border-blue-500 text-white rounded-xl px-4 py-3 text-sm outline-none transition-colors placeholder:text-gray-500"
              />
            </div>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-gray-300 mb-2">Asunto</label>
            <input
              type="text"
              name="asunto"
              required
              placeholder="¿En qué puedo ayudarte?"
              class="w-full bg-gray-800 border border-gray-700 focus:border-blue-500 text-white rounded-xl px-4 py-3 text-sm outline-none transition-colors placeholder:text-gray-500"
            />
          </div>

          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-300 mb-2">Mensaje</label>
            <textarea
              name="mensaje"
              required
              rows="5"
              placeholder="Cuéntame sobre tu proyecto..."
              class="w-full bg-gray-800 border border-gray-700 focus:border-blue-500 text-white rounded-xl px-4 py-3 text-sm outline-none transition-colors placeholder:text-gray-500 resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition-all hover:scale-105"
          >
            Enviar mensaje →
          </button>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>
