---
import BaseLayout from '../layouts/BaseLayout.astro';

const proyectos = [
  {
    titulo: 'Portfolio Personal',
    descripcion:
      'Mi portfolio profesional construido con Astro, React y TailwindCSS. Diseño moderno, responsive y optimizado para SEO.',
    tags: ['Astro', 'React', 'Tailwind'],
    demo: 'https://mi-portfolio-rho-seven.vercel.app',
    repo: 'https://github.com/Sagiiiii/mi-portfolio',
    destacado: true,
  },
  {
    titulo: 'App del Clima',
    descripcion:
      'Aplicación que muestra el clima en tiempo real usando la API de OpenWeather. Búsqueda por ciudad y geolocalización.',
    tags: ['React', 'API REST', 'Tailwind'],
    demo: '#',
    repo: '#',
    destacado: false,
  },
  {
    titulo: 'Todo App',
    descripcion:
      'Gestor de tareas con filtros por estado, prioridades y persistencia en localStorage.',
    tags: ['React', 'TypeScript', 'Tailwind'],
    demo: '#',
    repo: '#',
    destacado: false,
  },
  {
    titulo: 'Blog Personal',
    descripcion: 'Blog estático con colecciones de contenido en Markdown, categorías y búsqueda.',
    tags: ['Astro', 'Markdown', 'Tailwind'],
    demo: '#',
    repo: '#',
    destacado: false,
  },
];
---

<BaseLayout titulo="Proyectos">
  <main class="container mx-auto px-4 py-20">
    <!-- Header -->
    <div class="max-w-2xl mb-16 pt-8">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Mis <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-500"
          >Proyectos</span
        >
      </h1>
      <p class="text-gray-400 text-lg">
        Una selección de proyectos que he construido para aprender y demostrar mis habilidades.
      </p>
    </div>

    <!-- Proyecto destacado -->
    {
      proyectos
        .filter((p) => p.destacado)
        .map((proyecto) => (
          <div class="bg-gradient-to-br from-blue-600/10 to-purple-600/10 border border-blue-500/20 rounded-2xl p-8 mb-8 hover:border-blue-500/50 transition-all">
            <div class="flex items-center gap-2 mb-4">
              <span class="bg-blue-500/20 text-blue-400 text-xs font-semibold px-3 py-1 rounded-full border border-blue-500/20">
                ⭐ Proyecto destacado
              </span>
            </div>
            <h2 class="text-2xl font-bold text-white mb-3">{proyecto.titulo}</h2>
            <p class="text-gray-400 mb-6 max-w-2xl leading-relaxed">{proyecto.descripcion}</p>
            <div class="flex flex-wrap gap-2 mb-6">
              {proyecto.tags.map((tag) => (
                <span class="bg-blue-500/10 text-blue-400 text-xs font-medium px-3 py-1 rounded-full border border-blue-500/20">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex gap-4">
              <a
                href={proyecto.demo}
                target="_blank"
                class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-all hover:scale-105"
              >
                Ver demo →
              </a>
              <a
                href={proyecto.repo}
                target="_blank"
                class="inline-flex items-center gap-2 bg-gray-800 hover:bg-gray-700 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-all"
              >
                GitHub
              </a>
            </div>
          </div>
        ))
    }

    <!-- Grid de proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        proyectos
          .filter((p) => !p.destacado)
          .map((proyecto) => (
            <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 hover:border-blue-500/50 transition-all hover:-translate-y-1 flex flex-col">
              <h3 class="text-xl font-bold text-white mb-3">{proyecto.titulo}</h3>
              <p class="text-gray-400 text-sm mb-4 leading-relaxed flex-1">
                {proyecto.descripcion}
              </p>
              <div class="flex flex-wrap gap-2 mb-6">
                {proyecto.tags.map((tag) => (
                  <span class="bg-gray-800 text-gray-300 text-xs font-medium px-3 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex gap-4">
                <a
                  href={proyecto.demo}
                  class="text-sm text-blue-400 font-medium hover:text-blue-300 transition-colors"
                >
                  Ver demo →
                </a>
                <a
                  href={proyecto.repo}
                  class="text-sm text-gray-400 font-medium hover:text-white transition-colors"
                >
                  GitHub
                </a>
              </div>
            </div>
          ))
      }
    </div>
  </main>
</BaseLayout>
