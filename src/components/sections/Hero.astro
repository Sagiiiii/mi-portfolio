---

<section class="py-32 pt-24 flex items-center">
  <div class="container mx-auto px-4">
    <div class="max-w-3xl">
      <div
        class="inline-flex items-center gap-2 bg-blue-500/10 text-blue-400 text-sm font-medium px-4 py-1.5 rounded-full mb-6 border border-blue-500/20"
      >
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        Disponible para proyectos
      </div>

      <h1 class="text-5xl md:text-7xl font-bold text-white leading-tight mb-6">
        Hola, soy
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-purple-500">
          David Adolfo Garcia Giron
        </span>
      </h1>
      <p class="text-xl text-gray-400 mb-8 leading-relaxed">
        Desarrollador Frontend especializado en crear experiencias web
        <strong class="text-white">rápidas, accesibles y hermosas</strong>
        con Astro y React.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="/proyectos"
        class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-xl transition-all hover:scale-105"
      >
        Ver mis proyectos →
      </a>
      <a
        href="/contacto"
        class="inline-flex items-center justify-center gap-2 bg-gray-800 hover:bg-gray-700 text-white font-semibold px-8 py-4 rounded-xl transition-all"
      >
        Contactarme
      </a>
    </div>
  </div>
</section>
