---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/contacto', label: 'Contacto' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav
  class="sticky top-0 z-50 border-b border-border"
  style="background-color:#0E0E0E"
>
  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="font-display font-bold text-xl no-underline" style="color:#E8651A">
      🦊 <span style="color:#EFEFEF">Sagiii</span>.dev
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1 list-none m-0 p-0">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`px-3 py-2 text-sm rounded no-underline transition-colors font-medium ${
              isActive(link.href)
                ? 'text-fox'
                : 'text-muted hover:text-fox'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Hamburger -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 cursor-pointer bg-transparent border-none"
      aria-label="Abrir menú"
    >
      <span class="block w-6 h-0.5 bg-white"></span>
      <span class="block w-6 h-0.5 bg-white"></span>
      <span class="block w-6 h-0.5 bg-white"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border" style="background-color:#0E0E0E">
    <ul class="list-none m-0 p-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`block px-3 py-2.5 text-sm rounded no-underline transition-colors ${
              isActive(link.href)
                ? 'text-fox font-semibold'
                : 'text-muted hover:text-fox'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  document.getElementById('menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
