<section id="educacion" class="py-20 border-b border-border" style="background-color:#1A1A1A">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="font-display font-bold text-3xl mb-1 section-title">
      Experiencia & <span>Formación</span>
    </h2>
    <div class="fox-divider"></div>

    <div class="grid lg:grid-cols-2 gap-10">

      <!-- Experiencia profesional -->
      <div class="p-6 rounded-xl border border-border" style="background-color:#1E1E1E">
        <h3 class="font-bold text-base text-fox mb-6">💼 Experiencia Profesional</h3>
        <div style="position:relative">
          <div class="timeline-line"></div>
          {experience.map((job, i) => (
            <div style="position:relative;padding-left:36px" class={i < experience.length - 1 ? 'mb-8' : ''}>
              <div class="timeline-dot"></div>
              <div class="flex justify-between items-start flex-wrap gap-1 mb-1">
                <h4 class="font-bold text-sm">{job.role}</h4>
                <span class="tech-badge" style="font-size:0.62rem">{job.date}</span>
              </div>
              <p class="text-fox text-xs font-semibold mb-0.5">{job.company}</p>
              <p class="text-muted text-xs mb-1">📍 {job.location}</p>
              <p class="text-muted text-xs leading-relaxed">{job.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Formación académica -->
      <div class="p-6 rounded-xl border border-border" style="background-color:#1E1E1E">
        <h3 class="font-bold text-base text-fox mb-6">🎓 Formación Académica</h3>
        <div class="flex flex-col gap-5">
          {education.map((edu) => (
            <div class="flex gap-3">
              <div
                class="flex-shrink-0 w-11 h-11 rounded-xl flex items-center justify-center text-lg border border-fox"
                style="background-color:#252525"
              >
                {edu.icon}
              </div>
              <div>
                <span class="tech-badge mb-1 inline-block" style="font-size:0.62rem">{edu.year}</span>
                <h4 class="font-bold text-sm mb-0">{edu.degree}</h4>
                <p class="text-fox text-xs font-semibold mb-0">{edu.institution}</p>
                <p class="text-muted text-xs">{edu.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
